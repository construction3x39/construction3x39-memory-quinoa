{:paths ["src" "scripts"]
 :deps  {org.clojure/clojurescript {:mvn/version "1.11.132"}
         babashka/fs              {:mvn/version "0.5.20"}
         hiccup/hiccup           {:mvn/version "1.0.5"}
         org.clojure/data.json    {:mvn/version "2.5.0"}
         ;; LuaCLJ for Clojure->Lua transpilation
         luaclj/luaclj           {:git/url "https://github.com/luaclj/luaclj"
                                  :git/sha "main"}}
 :tasks
 { :requires ([babashka.fs :as fs]
              [babashka.process :refer [shell]]
              [clojure.string :as str]
              [clojure.data.json :as json]
              [hiccup.core :as h])

  doctor {:doc "Check Neovim configuration toolchain for aspiringly-sacred technology development"
          :task (do (println "✨ Aspiringly-Sacred Technology Neovim Configuration Toolchain Status")
                    (println "bb version:" (System/getProperty "babashka.version"))
                    (shell "bash" "-lc" "nvim --version | head -1 || echo '❌ Neovim not found'")
                    (shell "bash" "-lc" "lua -v || echo '❌ Lua not found'")
                    (shell "bash" "-lc" "luajit -v || echo '❌ LuaJIT not found'")
                    (shell "bash" "-lc" "clojure -Sdescribe | head -n 1 || echo '❌ Clojure not found'")
                    (shell "bash" "-lc" "clj-kondo --version || echo '❌ clj-kondo not found'")
                    (shell "bash" "-lc" "zprint --version || echo '❌ zprint not found'")
                    (shell "bash" "-lc" "git --version || echo '❌ Git not found'")
                    (println "")
                    (println "🌙 Toolchain ready for consciousness-serving Neovim development!"))}

  nvim:generate {:doc "Generate Lua configuration from Clojure sources using luaclj"
                 :task (do (println "🔄 Transpiling Clojure → Lua for aspiringly-sacred technology Neovim...")
                           (let [src-dir "src/nvim"
                                 lua-dir "lua"
                                 clj-files (->> (fs/glob src-dir "**/*.clj")
                                                (filter fs/file?)
                                                (sort-by fs/file-name))]
                             
                             (println "📁 Found Clojure source files:" (count clj-files))
                             (doseq [file clj-files]
                               (println "  📄" (fs/file-name file)))
                             
                             ;; Ensure output directory exists
                             (fs/create-dirs lua-dir)
                             
                             ;; Transpile each Clojure file to Lua
                             (doseq [clj-file clj-files]
                               (let [rel-path (fs/relativize src-dir clj-file)
                                     lua-path (str lua-dir "/" 
                                                   (str/replace (str rel-path) #"\.clj$" ".lua"))
                                     lua-dir-path (fs/parent lua-path)]
                                 
                                 (when lua-dir-path
                                   (fs/create-dirs lua-dir-path))
                                 
                                 (println "🔄 Transpiling:" (str clj-file) "→" lua-path)
                                 
                                 ;; Use luaclj to transpile
                                 (shell "clojure" "-M" "-e" 
                                        (str "(require '[luaclj.core :as lua]) "
                                             "(spit \"" lua-path "\" "
                                             "(lua/clj->lua (slurp \"" clj-file "\")))"))))
                             
                             (println "✨ Clojure → Lua transpilation complete!")
                             (println "📂 Generated Lua files in:" lua-dir)))}

  nvim:install {:doc "Install generated Neovim configuration to ~/.config/nvim"
                :task (do (println "📦 Installing aspiringly-sacred technology Neovim configuration...")
                          (let [target-dir (str (System/getProperty "user.home") "/.config/nvim")
                                backup-dir (str target-dir ".backup." (System/currentTimeMillis))]
                            
                            ;; Backup existing configuration
                            (when (fs/exists? target-dir)
                              (println "💾 Backing up existing config to:" backup-dir)
                              (shell "cp" "-r" target-dir backup-dir))
                            
                            ;; Create target directory
                            (fs/create-dirs target-dir)
                            
                            ;; Copy generated Lua files
                            (shell "cp" "-r" "lua" target-dir)
                            (shell "cp" "init.lua" target-dir)
                            
                            ;; Copy static assets
                            (when (fs/exists? "assets")
                              (shell "cp" "-r" "assets" target-dir))
                            
                            (println "✅ Sacred technology Neovim configuration installed!")
                            (println "🌙 Location:" target-dir)))}

  nvim:build {:depends [nvim:generate nvim:install]}

  nvim:dev {:doc "Development mode: watch Clojure files and auto-regenerate Lua"
            :task (do (println "👁️ Watching Clojure files for changes...")
                      (println "🔄 Auto-regenerating Lua on file changes")
                      (println "📁 Watching: src/nvim/**/*.clj")
                      (println "🌙 Press Ctrl+C to stop")
                      
                      ;; Simple file watching loop
                      (loop [last-modified 0]
                        (Thread/sleep 1000)
                        (let [current-modified (->> (fs/glob "src/nvim" "**/*.clj")
                                                    (map fs/last-modified-time)
                                                    (apply max 0))]
                          (when (> current-modified last-modified)
                            (println "🔄 Clojure files changed, regenerating Lua...")
                            (shell "bb" "nvim:generate")
                            (println "✨ Lua regeneration complete"))
                          (recur current-modified))))}

  nvim:test {:doc "Test generated Neovim configuration"
             :task (do (println "🧪 Testing aspiringly-sacred technology Neovim configuration...")
                       (shell "nvim" "--headless" "-c" "checkhealth" "-c" "qall")
                       (println "✅ Neovim configuration test complete"))}

  nvim:clean {:doc "Clean generated Lua files"
              :task (do (println "🧹 Cleaning generated Lua files...")
                        (when (fs/exists? "lua")
                          (fs/delete-tree "lua"))
                        (println "✅ Generated files cleaned"))}

  fmt {:doc "Format Clojure source code with contemplative attention (80 columns)"
       :task (shell "bash" "-lc" "zprint -w src/**/*.clj scripts/**/*.clj bb.edn || true")}

  lint {:doc "Lint Clojure source code for consciousness-serving quality"
        :task (shell "bash" "-lc" "clj-kondo --lint src scripts")}

  docs:generate {:doc "Generate documentation from Clojure docstrings"
                 :task (do (println "📚 Generating aspiringly-sacred technology documentation...")
                           (shell "clojure" "-M" "-e" 
                                  "(require 'clojure.repl) 
                                   (require 'clojure.java.io)
                                   (println \"📖 Documentation generation placeholder\")")
                           (println "✨ Documentation generation complete"))}

  deps:update {:doc "Update dependencies for aspiringly-sacred technology development"
               :task (do (println "🔄 Updating dependencies...")
                         (shell "clojure" "-M:deps" "tree")
                         (println "✅ Dependencies updated"))}

  build:all {:depends [nvim:generate docs:generate]}
  
  dev:all {:depends [nvim:dev]}
  
  ci:verify {:depends [doctor lint build:all nvim:test]}

  ;; Aspiringly-Sacred Technology Neovim Shortcuts
  nvim {:depends [nvim:build]}
  
  watch {:depends [nvim:dev]}}}

